  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "connect.sid",
        "description": "Session cookie created after successful GitHub OAuth login."
      }
    },

    "parameters": {
      "id": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "MongoDB ObjectId",
        "schema": {
          "type": "string"
        }
      }
    },

    "schemas": {
      "Booking": {
        "type": "object",
        "required": [
          "customerName",
          "email",
          "phone",
          "destination",
          "travelDate",
          "numberOfPeople"
        ],
        "properties": {
          "customerName": {
            "type": "string",
            "example": "Emily Emerson"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "emily@example.com"
          },
          "phone": {
            "type": "string",
            "example": "+256700000000"
          },
          "destination": {
            "type": "string",
            "example": "Murchison Falls"
          },
          "travelDate": {
            "type": "string",
            "format": "date",
            "example": "2026-12-15"
          },
          "numberOfPeople": {
            "type": "integer",
            "minimum": 1,
            "example": 2
          },
          "status": {
            "type": "string",
            "enum": [
              "Pending",
              "Confirmed",
              "Cancelled"
            ],
            "example": "Pending"
          },
          "specialRequests": {
            "type": "string",
            "example": "Airport pickup requested"
          }
        }
      },

      "Destination": {
        "type": "object",
        "required": [
          "name",
          "location",
          "description",
          "price",
          "duration",
          "category",
          "available",
          "image"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Murchison Falls National Park"
          },
          "location": {
            "type": "string",
            "example": "Uganda"
          },
          "description": {
            "type": "string",
            "example": "A popular safari destination in Uganda."
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "example": 250000
          },
          "duration": {
            "type": "string",
            "example": "3 days"
          },
          "category": {
            "type": "string",
            "example": "Safari"
          },
          "available": {
            "type": "boolean",
            "example": true
          },
          "image": {
            "type": "string",
            "example": "murchison-falls.jpg"
          }
        }
      },

      "Hotel": {
        "type": "object",
        "required": [
          "name",
          "location",
          "description",
          "pricePerNight",
          "rating",
          "roomsAvailable",
          "amenities",
          "image"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Paraa Safari Lodge"
          },
          "location": {
            "type": "string",
            "example": "Murchison Falls, Uganda"
          },
          "description": {
            "type": "string",
            "example": "A comfortable safari lodge near Murchison Falls National Park."
          },
          "pricePerNight": {
            "type": "number",
            "minimum": 0,
            "example": 450000
          },
          "rating": {
            "type": "number",
            "minimum": 1,
            "maximum": 5,
            "example": 4.5
          },
          "roomsAvailable": {
            "type": "integer",
            "minimum": 0,
            "example": 12
          },
          "amenities": {
            "type": "string",
            "example": "WiFi, swimming pool, restaurant, parking"
          },
          "image": {
            "type": "string",
            "example": "paraa-lodge.jpg"
          }
        }
      },

      "Tour": {
        "type": "object",
        "required": [
          "name",
          "destination",
          "description",
          "price",
          "duration",
          "category",
          "maxPeople",
          "available",
          "image"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "Murchison Falls Safari Tour"
          },
          "destination": {
            "type": "string",
            "example": "Murchison Falls National Park"
          },
          "description": {
            "type": "string",
            "example": "A three-day safari experience exploring Murchison Falls National Park."
          },
          "price": {
            "type": "number",
            "minimum": 0,
            "example": 850000
          },
          "duration": {
            "type": "string",
            "example": "3 days"
          },
          "category": {
            "type": "string",
            "example": "Safari"
          },
          "maxPeople": {
            "type": "integer",
            "minimum": 1,
            "example": 10
          },
          "available": {
            "type": "boolean",
            "example": true
          },
          "image": {
            "type": "string",
            "example": "murchison-safari.jpg"
          }
        }
      }
    }
  }
}