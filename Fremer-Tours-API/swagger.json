{
  "openapi": "3.0.0",
  "info": {
    "title": "Fremer Tours and Travel API",
    "description": "REST API for managing destinations, bookings, hotels, and tours for Fremer Tours and Travel.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://cse341-mkb0.onrender.com",
      "description": "Render production server"
    }
  ],
  "paths": {
    "/auth/github": {
      "get": {
        "summary": "Login with GitHub",
        "description": "Redirects the user to GitHub to authenticate.",
        "responses": {
          "302": {
            "description": "Redirect to GitHub for authentication"
          }
        }
      }
    },
    "/auth/github/callback": {
      "get": {
        "summary": "GitHub OAuth callback",
        "description": "Handles the response from GitHub after successful authentication.",
        "responses": {
          "200": {
            "description": "GitHub login successful"
          },
          "401": {
            "description": "GitHub login failed"
          }
        }
      }
    },
    "/auth/logout": {
      "get": {
        "summary": "Logout",
        "description": "Logs out the currently authenticated user and destroys the session.",
        "responses": {
          "200": {
            "description": "Logout successful"
          }
        }
      }
    },
    "/auth/login-failed": {
      "get": {
        "summary": "Login failed",
        "description": "Returns an error when GitHub authentication fails.",
        "responses": {
          "401": {
            "description": "GitHub login failed"
          }
        }
      }
    },

    "/bookings": {
      "get": {
        "summary": "Get all bookings",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Bookings retrieved successfully"
          },
          "401": {
            "description": "Authentication required. Please log in with GitHub."
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "post": {
        "summary": "Create a booking",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Booking"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Booking created successfully"
          },
          "400": {
            "description": "Validation error"
          },
          "401": {
            "description": "Authentication required. Please log in with GitHub."
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },

    "/bookings/{id}": {
      "get": {
        "summary": "Get a booking by ID",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "responses": {
          "200": {
            "description": "Booking retrieved successfully"
          },
          "400": {
            "description": "Invalid booking ID"
          },
          "401": {
            "description": "Authentication required. Please log in with GitHub."
          },
          "404": {
            "description": "Booking not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "put": {
        "summary": "Update a booking",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Booking"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Booking updated successfully"
          },
          "400": {
            "description": "Validation error or invalid booking ID"
          },
          "401": {
            "description": "Authentication required. Please log in with GitHub."
          },
          "404": {
            "description": "Booking not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      },
      "delete": {
        "summary": "Delete a booking",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/id"
          }
        ],
        "responses": {
          "204": {
            "description": "Booking deleted successfully"
          },
          "400": {
            "description": "Invalid booking ID"
          },
          "401": {
            "description": "Authentication required. Please log in with GitHub."
          },
          "404": {
            "description": "Booking not found"
          },
          "500": {
            "description": "Server error"
          }
        }
      }
    },

